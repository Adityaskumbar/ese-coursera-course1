#include "data.h"
#include "memory.h"

uint8_t my_itoa(int32_t data, uint8_t * ptr, uint32_t base)
{
  uint8_t * p = ptr;
  uint8_t length = 0;
  int negative = 0;
  uint32_t value;
  uint32_t digit;
   
  if (data < 0)
  {
    negative = 1;
    value = (uint32_t)(-(int64_t)data);
  }
  else
  {
    value = (uint32_t)data;
  }

  if (value == 0)
  {
    *p = '0';
    p++;
    length++;
  }

}


uint8_t * my_memset(uint8_t * src, size_t length, uint8_t value)
{
  uint8_t * p = src;
  size_t i;
  for (i = 0; i < length; i++)
  {
    *p = value;
    p++;
  }
  return src;
}

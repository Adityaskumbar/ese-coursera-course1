/**
 * @file stats.c
 * @brief Statistics application for the Week 1 assignment
 *
 * Analyzes an array of unsigned char data and reports its maximum, minimum,
 * mean and median. It also sorts the data from largest to smallest and
 * prints the array before and after sorting. All statistics are rounded
 * down to the nearest integer.
 *
 * @author Verril
 * @date November 2, 2026
 *
 */

#include <stdio.h>
#include "stats.h"

/* Size of the Data Set */
#define SIZE (40)


void print_statistics(unsigned char *data, unsigned int length) {
  printf("\n========== Statistics ==========\n");
  printf("  Maximum : %u\n", find_maximum(data, length));
  printf("  Minimum : %u\n", find_minimum(data, length));
  printf("  Mean    : %u\n", find_mean(data, length));
  printf("  Median  : %u\n", find_median(data, length));
  printf("================================\n");
}

void print_array(unsigned char *data, unsigned int length) {
  unsigned int i;

  for (i = 0; i < length; i++) {
    printf("[%2u] %3u", i, data[i]);
    /* Eight values per row, separated by tabs */
    if ((i + 1) % 8 == 0 || i == length - 1) {
      printf("\n");
    } else {
      printf("\t");
    }
  }
}

unsigned char find_median(unsigned char *data, unsigned int length) {
  unsigned char copy[SIZE];
  unsigned int i;

  if (length == 0 || length > SIZE) {
    return 0;
  }

  /* Sort a copy so the caller's array is left unchanged */
  for (i = 0; i < length; i++) {
    copy[i] = data[i];
  }
  sort_array(copy, length);

  if (length % 2 == 0) {
    /* Average of the two middle values; integer division rounds down */
    return (unsigned char)(((unsigned int)copy[length / 2 - 1] +
                            (unsigned int)copy[length / 2]) / 2);
  }
  return copy[length / 2];
}

unsigned char find_mean(unsigned char *data, unsigned int length) {
  unsigned int sum = 0;
  unsigned int i;

  if (length == 0) {
    return 0;
  }

  for (i = 0; i < length; i++) {
    sum += data[i];
  }
  /* Integer division rounds the mean down */
  return (unsigned char)(sum / length);
}

unsigned char find_maximum(unsigned char *data, unsigned int length) {
  unsigned char max;
  unsigned int i;

  if (length == 0) {
    return 0;
  }

  max = data[0];
  for (i = 1; i < length; i++) {
    if (data[i] > max) {
      max = data[i];
    }
  }
  return max;
}

unsigned char find_minimum(unsigned char *data, unsigned int length) {
  unsigned char min;
  unsigned int i;

  if (length == 0) {
    return 0;
  }

  min = data[0];
  for (i = 1; i < length; i++) {
    if (data[i] < min) {
      min = data[i];
    }
  }
  return min;
}

void sort_array(unsigned char *data, unsigned int length) {
  unsigned int i, j;
  unsigned char temp;

  if (length < 2) {
    return;
  }

  /* Bubble sort in descending order */
  for (i = 0; i < length - 1; i++) {
    for (j = 0; j < length - 1 - i; j++) {
      if (data[j] < data[j + 1]) {
        temp = data[j];
        data[j] = data[j + 1];
        data[j + 1] = temp;
      }
    }
  }
}
